# En tu computadora no hace falta completar nada: sin estas variables la app
# usa una base de datos local (.data/) y guarda las fotos en public/uploads/.
#
# En Vercel:
#   DATABASE_URL          -> la crea sola la integración Neon (Storage > Create Database > Neon)
#   BLOB_READ_WRITE_TOKEN -> la crea sola Vercel Blob (Storage > Create Database > Blob)
#   AUTH_SECRET           -> la cargás vos: un texto largo y aleatorio (firma las sesiones)

DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
AUTH_SECRET=
